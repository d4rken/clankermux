{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"noUncheckedSideEffectImports": false,
		"types": ["bun-types"],
		"jsx": "react-jsx",
		"paths": {
			"@clankermux/core/env": ["./packages/core/src/env.ts"],
			"@clankermux/*": ["./packages/*/src"],
			"@clankermux/server": ["./apps/server/src/server.ts"],
			"@clankermux/dashboard-web/dist/*": ["./packages/dashboard-web/dist/*"]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"apps/*/src/**/*",
		// The backtest harness is a development tool, but it is real code with a
		// unit-tested core, so both it and its integration test are typechecked.
		// The other scripts/ files stay as they are.
		"scripts/prediction-backtest.ts",
		"scripts/prediction-backtest.test.ts",
		// Same deal for the ledger-burn feasibility study, plus the read-only
		// database/out-path guards both tools share.
		"scripts/db-tool-io.ts",
		"scripts/ledger-feasibility.ts",
		"scripts/ledger-feasibility.test.ts",
		// Same reasoning, and more load-bearing: this is the only way to set the
		// management password and the only way to recover from a forgotten one,
		// so it must not be the one file a type error can reach production in.
		"scripts/auth-password.ts",
		"scripts/devin-login.ts",
		"scripts/devin-check.ts",
		"scripts/auth-password.test.ts",
		// Historical cost repair writes estimates against the live request schema.
		"scripts/backfill-request-costs.ts",
		"scripts/backfill-request-costs.test.ts",
		// This one rewrites requests.project in place. It went unnoticed for a
		// release assigning an object where a string was expected, which would
		// have written "[object Object]" into every re-derived row — precisely
		// because it was not typechecked.
		"scripts/backfill-project-names.ts",
		"scripts/backfill-missing-projects.ts",
		// The README screenshot pipeline. Typechecked because seed-mock-db.ts
		// reaches into packages/http-api for the password hasher and writes raw
		// SQL against the live schema: a rename on either side should fail here,
		// not silently produce a database the capture instance cannot serve.
		"scripts/cdp/client.ts",
		"scripts/readme-media/capture.ts",
		"scripts/readme-media/mock-data.ts",
		"scripts/readme-media/seed-mock-db.ts",
		"scripts/readme-media/stub-upstream.ts",
		// The browser-driving bulk-catalogue harness and its seeded fixture, which
		// assert against the live database schema and the dashboard's real DOM: a
		// rename on either side should fail here, not several minutes into a run.
		"scripts/cdp/click-target.test.ts",
		"scripts/e2e/bulk-catalogue.ts",
		"scripts/e2e/seed-bulk-db.ts",
		// The Clients-tab QA rig, for the same reason as seed-mock-db.ts above: it
		// reaches into packages/http-api for the password hasher and writes raw
		// SQL against the live request schema.
		"scripts/qa/seed-client-analytics.ts",
		// Test files that live outside the globs above. `include` is an
		// allowlist, so no `exclude` change can reach them; they are named here
		// so "every test file is typechecked" is literally true.
		"__tests__/api-auth.test.ts",
		"packages/database/scripts/workers-manifest.test.ts",
		"scripts/alignment-study.test.ts",
		"scripts/backfill-missing-projects.test.ts",
		"scripts/build-guard.test.ts",
		"scripts/build-readme-media.test.ts",
		"scripts/forecast-confidence-backtest.test.ts",
		"scripts/public-api/schema.test.ts",
		"scripts/redistribution-backtest.test.ts",
		"scripts/smoke-server-binary.test.ts"
	],
	"exclude": ["node_modules", "**/node_modules"]
}
